<?xml version="1.0.0"?>
<robot  xmlns:xacro="http://www.ros.org/wiki/xacro" name="MercuyrE1" >
	
<xacro:property name="width" value=".2" />

  <!-- base -->
  <link name="base">
    <visual>
      <geometry>
       <mesh filename="package://mercury_description/urdf/mercury_e1/E1_ALL.dae"/>
      </geometry>
      <origin xyz = "0 0 0 " rpy = " 0 0 0"/>
    </visual>
    <collision>
      <origin xyz = "0 0 0.0 " rpy = " 0 0 0"/>
      <geometry>
        <mesh filename="package://mercury_description/urdf/mercury_e1/E1_ALL.dae"/>
      </geometry>
    </collision>
  </link>

</robot>
